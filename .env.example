# KannadaConnect - Environment Configuration
# Copy this file to .env.local or set these in your hosting provider (e.g., Vercel)

# 1. Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (safe to use in frontend, protected by Row Level Security)
# NEVER put your service_role key here.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
